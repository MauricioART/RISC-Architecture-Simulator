<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.arturoar.controller.RISC_SimulatorController" styleClass="debugger"
            stylesheets="@debugger.css">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="toolbar">
                <VBox spacing="2" minWidth="190" HBox.hgrow="ALWAYS">
                    <Label text="Simulador RISC" styleClass="app-title" />
                    <Label fx:id="programName" styleClass="muted" maxWidth="380" />
                </VBox>
                <Button fx:id="loadBtn" text="Cargar programa" onAction="#handleLoad" />
                <Button fx:id="clearBtn" text="Limpiar" onAction="#handleClear" />
                <Button fx:id="runBtn" text="Ejecutar" onAction="#handleRun" minWidth="84" />
                <Button fx:id="nextBtn" text="Paso" onAction="#handleNext" styleClass="step-button" />
            </HBox>
            <Label fx:id="status" styleClass="status" maxWidth="Infinity" wrapText="true" />
        </VBox>
    </top>
    <center>
        <HBox spacing="14" styleClass="workspace">
            <VBox styleClass="panel" HBox.hgrow="ALWAYS" minWidth="0">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-heading">
                    <Label text="Programa y memoria" styleClass="panel-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Direcciones hexadecimales" styleClass="muted" />
                </HBox>
                <TableView fx:id="memoryTV" VBox.vgrow="ALWAYS" accessibleText="Programa y memoria">
                    <columns>
                        <TableColumn fx:id="addressTC" text="Dir." prefWidth="65" minWidth="58"
                                     sortable="false" />
                        <TableColumn fx:id="instructionTC" text="Instrucción" prefWidth="147" minWidth="125"
                                     sortable="false" />
                        <TableColumn fx:id="contentBinTC" text="Binario" prefWidth="160" minWidth="148"
                                     sortable="false" />
                        <TableColumn fx:id="contentHexTC" text="Hex" prefWidth="63" minWidth="56"
                                     sortable="false" />
                        <TableColumn fx:id="contentDecTC" text="Decimal" prefWidth="80" minWidth="74"
                                     sortable="false" />
                    </columns>
                </TableView>
            </VBox>
            <VBox styleClass="panel" minWidth="230" prefWidth="230">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-heading">
                    <Label text="Estado de la CPU" styleClass="panel-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Hex" styleClass="muted" />
                </HBox>
                <VBox spacing="10" styleClass="cpu-body">
                    <Label text="Registros generales" styleClass="section-title" />
                    <GridPane vgap="4" hgap="10">
                        <Label text="Ax" />
                        <Label fx:id="ax" styleClass="register-value" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Label text="Bx" GridPane.rowIndex="1" />
                        <Label fx:id="bx" styleClass="register-value" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" />
                        <Label text="Cx" GridPane.rowIndex="2" />
                        <Label fx:id="cx" styleClass="register-value" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity" />
                        <Label text="Dx" GridPane.rowIndex="3" />
                        <Label fx:id="dx" styleClass="register-value" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity" />
                        <Label text="Ex" GridPane.rowIndex="4" />
                        <Label fx:id="ex" styleClass="register-value" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity" />
                        <Label text="Fx" GridPane.rowIndex="5" />
                        <Label fx:id="fx" styleClass="register-value" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity" />
                        <Label text="Gx" GridPane.rowIndex="6" />
                        <Label fx:id="gx" styleClass="register-value" GridPane.rowIndex="6" GridPane.columnIndex="1" maxWidth="Infinity" />
                        <Label text="Hx" GridPane.rowIndex="7" />
                        <Label fx:id="hx" styleClass="register-value" GridPane.rowIndex="7" GridPane.columnIndex="1" maxWidth="Infinity" />
                    </GridPane>
                    <Label text="Registros de control" styleClass="section-title" />
                    <GridPane hgap="7" vgap="4">
                        <Label text="PC" />
                        <Label fx:id="pc" styleClass="register-value" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Label text="IR" GridPane.columnIndex="2" />
                        <Label fx:id="ir" styleClass="register-value" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Label text="CS" GridPane.rowIndex="1" />
                        <Label fx:id="cs" styleClass="register-value" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity">
                            <tooltip><Tooltip text="Binario: 00000000 · Decimal: 0" /></tooltip>
                        </Label>
                        <Label text="DS" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                        <Label fx:id="ds" styleClass="register-value" GridPane.rowIndex="1" GridPane.columnIndex="3" maxWidth="Infinity" />
                    </GridPane>
                    <Label text="Banderas" styleClass="section-title" />
                    <HBox spacing="6">
                        <Label fx:id="sign" styleClass="flag" accessibleHelp="Bandera de signo">
                            <tooltip><Tooltip text="Signo" /></tooltip>
                        </Label>
                        <Label fx:id="zero" styleClass="flag" accessibleHelp="Bandera de cero">
                            <tooltip><Tooltip text="Cero" /></tooltip>
                        </Label>
                        <Label fx:id="overflow" styleClass="flag" accessibleHelp="Bandera de desbordamiento">
                            <tooltip><Tooltip text="Desbordamiento" /></tooltip>
                        </Label>
                        <Label fx:id="carry" styleClass="flag" accessibleHelp="Bandera de acarreo">
                            <tooltip><Tooltip text="Acarreo" /></tooltip>
                        </Label>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
